# Environment for the E2E screenshot run (copied to .env, see docs-extended/SCREENSHOTS.md).
# Only for a throwaway test installation with example data.
APP_NAME="openwehr"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_DE

LOG_CHANNEL=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=openwehr_e2e
DB_USERNAME=openwehr
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=129600
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=sync

# Mails (incl. the magic link the tests log in with) are written to storage/logs/laravel.log
MAIL_MAILER=log
MAIL_FROM_ADDRESS="info@example.com"
MAIL_FROM_NAME="openwehr"

ADMIN_EMAILS=admin@example.com
