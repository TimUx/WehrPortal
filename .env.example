APP_NAME="WehrPortal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Europe/Berlin
APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_DE

# Docker Compose: pin a published GitHub Container Registry release
WEHRPORTAL_VERSION=v0.9.5.5

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=wehrportal
DB_USERNAME=wehrportal
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=129600
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="info@example.com"
MAIL_FROM_NAME="WehrPortal"

MAGIC_LINK_TTL_MINUTES=15

# Kommagetrennt; werden beim Container-Start als Admins angelegt/aktiviert
ADMIN_EMAILS=

# Wachen-Monitor ohne Login unter /monitor/<DISPLAY_TOKEN> (leer = nur für Admins)
# Erzeugen z. B. mit: openssl rand -hex 24
DISPLAY_TOKEN=

# Vorbereitete Führungs-Capabilities; keine freigegebenen Modulansichten
LOCATIONS_LEADERSHIP_ENABLED=false

VITE_APP_NAME="${APP_NAME}"
